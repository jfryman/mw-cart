#!/usr/bin/env python3
# Minimal rsvg-convert stand-in for KiBot inside the KiCad flatpak, backed by host ImageMagick.
import os, subprocess, sys
a = sys.argv[1:]; dpi = None; w = h = None; out = None; fmt = 'png'; bg = None; src = []
i = 0
while i < len(a):
    o = a[i]
    def val():
        global i
        if '=' in o: return o.split('=', 1)[1]
        i += 1; return a[i]
    if o.startswith(('--dpi-x', '-d')): dpi = val()
    elif o.startswith(('--dpi-y', '-p')): val()
    elif o.startswith(('--width', '-w')): w = val()
    elif o.startswith(('--height', '-h')): h = val()
    elif o.startswith(('--output', '-o')): out = val()
    elif o.startswith(('--format', '-f')): fmt = val()
    elif o.startswith(('--background-color', '-b')): bg = val()
    elif o.startswith(('--zoom', '-z', '--keep-aspect-ratio', '-a', '--unlimited', '-u')):
        if o in ('-z', '--zoom'): val()
    else: src.append(o)
magick = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'magick')
cmd = [magick, '-background', bg or 'none']
if dpi: cmd += ['-density', dpi]
cmd += [src[0] if src else 'svg:-']
if w or h: cmd += ['-resize', f'{w or ""}x{h or ""}']
cmd += [f'{fmt}:{out or "-"}']
sys.exit(subprocess.call(cmd))

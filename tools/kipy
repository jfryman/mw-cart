#!/bin/sh
# Run a Python that can `import pcbnew` (KiCad's own), on Linux or macOS:
# $KICAD_PYTHON, KiCad.app's bundled Python, host python3 if it has pcbnew
# (Arch/Omarchy `kicad` package), then the org.kicad.KiCad flatpak.
#   tools/kipy tools/fill.py mega-wifi.kicad_pcb /tmp/filled.kicad_pcb
if [ -n "$KICAD_PYTHON" ]; then exec "$KICAD_PYTHON" "$@"; fi
app=/Applications/KiCad/KiCad.app/Contents/Frameworks/Python.framework/Versions/Current/bin/python3
if [ -x "$app" ]; then exec "$app" "$@"; fi
if command -v python3 >/dev/null 2>&1 && python3 -c 'import pcbnew' >/dev/null 2>&1; then exec python3 "$@"; fi
if command -v flatpak >/dev/null 2>&1 && flatpak info org.kicad.KiCad >/dev/null 2>&1; then
	exec flatpak run --filesystem=host --command=python3 org.kicad.KiCad "$@"
fi
echo "kipy: no Python with pcbnew found (install KiCad, or set KICAD_PYTHON)" >&2
exit 127
